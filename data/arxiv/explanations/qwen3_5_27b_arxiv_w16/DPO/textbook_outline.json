{
  "outline": [
    {
      "chapter_title": "Introduction to Language Model Alignment and the RLHF Paradigm",
      "description": "This chapter establishes the foundational context for aligning Large Language Models (LLMs) with human values. It explores the limitations of unsupervised pre-training, the necessity of preference learning, and provides a detailed walkthrough of the standard Reinforcement Learning from Human Feedback (RLHF) pipeline, highlighting its complexity and instability.",
      "subtopics": [
        "The gap between unsupervised pre-training and desired model behavior",
        "The role of human preferences in steering model outputs",
        "Overview of the standard RLHF pipeline: SFT, Reward Modeling, and RL Fine-tuning",
        "Challenges of RLHF: Computational cost, hyperparameter sensitivity, and training instability",
        "Motivation for a simpler, more direct optimization approach"
      ]
    },
    {
      "chapter_title": "Mathematical Foundations: Preference Models and Constrained Optimization",
      "description": "Before deriving DPO, this chapter builds the necessary theoretical framework. It covers the statistical models used to represent human preferences (Bradley-Terry), the formulation of the reward maximization problem with KL-divergence constraints, and the analytical solution for optimal policies in RL.",
      "subtopics": [
        "The Bradley-Terry model for pairwise preference probabilities",
        "Formulating the RLHF objective: Maximizing reward with KL-divergence constraints",
        "Deriving the closed-form optimal policy ($\\pi^*$) from a reward function",
        "The role of the partition function ($Z(x)$) and its estimation challenges",
        "Equivalence classes of reward functions and their impact on optimal policies"
      ]
    },
    {
      "chapter_title": "Deriving Direct Preference Optimization (DPO)",
      "description": "This is the core technical chapter where DPO is derived from first principles. It explains the key insight of reparameterizing the reward function in terms of policy ratios, allowing the elimination of the explicit reward model and RL loop in favor of a direct classification objective.",
      "subtopics": [
        "The change-of-variables technique: Expressing reward as a function of policy ratios",
        "Substituting reparameterized rewards into the Bradley-Terry model",
        "Cancelling out the partition function to isolate policy terms",
        "Formulating the DPO loss function ($\\mathcal{L}_{DPO}$) as a binary cross-entropy objective",
        "Interpreting DPO as implicit reward modeling within a single network"
      ]
    },
    {
      "chapter_title": "Mechanistic Understanding: Gradients and Stability in DPO",
      "description": "This chapter analyzes how DPO updates model parameters during training. It breaks down the gradient flow to explain how DPO increases preferred responses while suppressing dispreferred ones, specifically focusing on why DPO avoids mode collapse better than naive probability ratio methods.",
      "subtopics": [
        "Analyzing the gradient of $\\mathcal{L}_{DPO}$ with respect to model parameters",
        "The role of dynamic importance weighting in preventing model degeneration",
        "Comparison with naive 'unlikelihood' training methods",
        "How DPO implicitly handles baseline estimation without explicit value functions",
        "Diagnosing instabilities in Actor-Critic algorithms (PPO) through the DPO lens"
      ]
